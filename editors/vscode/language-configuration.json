{
  "comments": {
    "lineComment": "--",
    "blockComment": [
      "{-",
      "-}"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "/",
      "close": "/",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "{-",
      "close": "-}",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "{-#",
      "close": "#-}",
      "notIn": [
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "/",
      "/"
    ],
    [
      "`",
      "`"
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "(?:\\b(?:where|do|operators)\\b|\\bcontext\\s+do\\b|\\[\\s*$)",
    "decreaseIndentPattern": "^\\s*(?:\\]|\\)|\\})"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:=\\s+.*|\\|\\s+.*)$",
      "action": {
        "indent": "none"
      }
    },
    {
      "beforeText": "^.*\\b(?:where|do|context\\s+do|operators)\\s*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*\\|\\s*.*$",
      "action": {
        "indent": "none",
        "appendText": "| "
      }
    }
  ],
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_']*"
}
