{
  "Module Declaration": {
    "prefix": "module",
    "body": [
      "module ${1:MyGrammar} (${2:program}) where",
      "",
      "import Parsley.Prelude (${3:sepBy, many, eof})",
      "",
      "-- Lexer",
      "skip  ws    = /[[:space:]]+/",
      "token ident = /[a-zA-Z_][a-zA-Z0-9_]*/ :: Text",
      "",
      "-- AST",
      "data ${4:Ast}",
      "  = ${5:Node} Text",
      "",
      "-- Syntax",
      "${2:program} :: ${4:Ast}",
      "${2:program} = (${5:Node} <$> ident) <* eof",
      "",
      "example \"basic\" : \"${6:hello}\" parses-to ${5:Node} \"${6:hello}\"",
      "$0"
    ],
    "description": "Create a new Parsley grammar module with lexer, AST, start rule, and example"
  },
  "Token Declaration": {
    "prefix": "token",
    "body": [
      "token ${1:name} = /${2:[a-zA-Z_][a-zA-Z0-9_]*}/ :: ${3:Text}$0"
    ],
    "description": "Declare a named regex token with a result type"
  },
  "Skip Token Declaration": {
    "prefix": "skip",
    "body": [
      "skip ${1:ws} = /${2:[[:space:]]+}/$0"
    ],
    "description": "Declare a skipped token (whitespace or comment)"
  },
  "Lexer Mode": {
    "prefix": "mode",
    "body": [
      "mode ${1:string} where",
      "  token ${2:chars} = /${3:[^\"]+}/",
      "  token ${4:close} = \"${5:\\\"}\" -> pop",
      "",
      "token ${6:open} = \"${5:\\\"}\" -> push ${1:string}$0"
    ],
    "description": "Declare a stateful lexer mode with push/pop transitions"
  },
  "Data Type ADT": {
    "prefix": "data",
    "body": [
      "data ${1:Expr}",
      "  = ${2:Ctor1} ${3:Text}",
      "  | ${4:Ctor2} ${1:Expr} ${1:Expr}$0"
    ],
    "description": "Declare an algebraic data type for the AST"
  },
  "Rule Signature and Definition": {
    "prefix": "rule",
    "body": [
      "${1:myRule} :: ${2:Expr}",
      "${1:myRule}",
      "  = ${3:Ctor} <$> ${4:ident}",
      "  | ${5:fallback}$0"
    ],
    "description": "Declare a typed grammar rule with alternatives"
  },
  "Operators Precedence Table": {
    "prefix": "operators",
    "body": [
      "operators ${1:atom}",
      "  [ infixl ${2:6} [\"${3:+}\" => ${4:Bin Add}, \"${5:-}\" => ${6:Bin Sub}]",
      "  , infixl ${7:7} [\"${8:*}\" => ${9:Bin Mul}, \"${10:/}\" => ${11:Bin Div}]",
      "  , prefix ${12:9} [\"${13:-}\" => ${14:Neg}]",
      "  ]$0"
    ],
    "description": "Create an operators precedence/associativity table"
  },
  "Applicative Do Block": {
    "prefix": "do",
    "body": [
      "do",
      "  ${1:x} <- ${2:ident}",
      "  \"${3:=}\"",
      "  ${4:e} <- ${5:expr}",
      "  pure (${6:Ctor} ${1:x} ${4:e})$0"
    ],
    "description": "Create an ApplicativeDo sequence block"
  },
  "Context-Sensitive Do Block": {
    "prefix": "context do",
    "body": [
      "context do",
      "  ${1:name} <- \"<\" *> ${2:ident} <* \">\"",
      "  ${3:body} <- many ${4:node}",
      "  \"</\" *> exactly ${1:name} <* \">\"",
      "  pure (${5:Elem} ${1:name} ${3:body})$0"
    ],
    "description": "Create a context-sensitive monadic do block using `exactly`"
  },
  "Example Parses-To Assertion": {
    "prefix": "example",
    "body": [
      "example \"${1:test name}\" : \"${2:input}\" parses-to ${3:ExpectedAst}$0"
    ],
    "description": "Add an inline `parses-to` grammar assertion"
  },
  "Example Fails-At Assertion": {
    "prefix": "fails-at",
    "body": [
      "example \"${1:error case}\" : \"${2:bad input}\" fails-at (${3:1}, ${4:4}) expecting \"${5:expression}\"$0"
    ],
    "description": "Add an inline `fails-at` negative grammar assertion"
  },
  "Compiler Pragma": {
    "prefix": "pragma",
    "body": [
      "{-# ${1|START,MODE,BACKEND,PREC,NOFACTOR|} ${2:program} #-}$0"
    ],
    "description": "Insert a Parsley compiler pragma ({-# ... #-})"
  },
  "PSL Semantics Module": {
    "prefix": "semantics",
    "body": [
      "{-# LANGUAGE Sem1 #-}",
      "semantics ${1:MyLang} where",
      "",
      "import ${1:MyLang}",
      "import Parsley.Sem.Prelude",
      "",
      "source ref = manual \"${2:Language Reference}\" rev \"${3:1.0}\"",
      "",
      "-- Diagnostics",
      "diag E_UNDECLARED :: Error \"Undeclared identifier `{name}`\"",
      "",
      "-- AST Node Semantics",
      "node ${4:Var} ${5:x} where",
      "  sym <- lookup Variable ${5:x} `orFail` E_UNDECLARED { name = ${5:x} }",
      "  type = typeOf sym",
      "",
      "-- Lint Rules",
      "{-# SOURCE ref \"1.1\"; STATUS verified; CONFIDENCE 0.95 #-}",
      "lint ${6:myLint} :: Warning, Correctness",
      "  match (${7:BinOp} _ l r)",
      "  when  ${8:constFold r == Just 0}",
      "  say   \"${9:Suspicious operation}\"",
      "",
      "example ${6:myLint}",
      "  fires  \"${10:1 / 0}\"",
      "  silent \"${11:1 / 2}\"",
      "",
      "profile default = [${6:myLint}]",
      "$0"
    ],
    "description": "Create a Parsley Semantic Layer (.psem) module"
  },
  "PSL Diagnostic Declaration": {
    "prefix": "diag",
    "body": [
      "diag ${1:E_CODE} :: ${2|Error,Warning,Note|} \"${3:Message with {arg}}\"$0"
    ],
    "description": "Declare a PSL diagnostic code and template"
  },
  "PSL Node Semantic Rule": {
    "prefix": "node",
    "body": [
      "node ${1:Ctor} ${2:x} where",
      "  ${3:sym <- lookup Variable ${2:x} `orFail` E_UNDECLARED { name = ${2:x} }}",
      "  type = ${4:typeOf sym}$0"
    ],
    "description": "Declare semantic equations for an AST constructor node"
  },
  "PSL Control-Flow Edge": {
    "prefix": "flow",
    "body": [
      "flow ${1:If} ${2:cond} ${3:thenBranch} ${4:elseBranch} = ${5|branch,chain,loop,jump,jumpOut,jumpTo|} ${2:cond} [${3:thenBranch}, ${4:elseBranch}]$0"
    ],
    "description": "Declare a CFG edge equation in PSL"
  },
  "PSL Dataflow Analysis": {
    "prefix": "analysis",
    "body": [
      "analysis ${1:Initialized} :: ${2|Forward,Backward|}, ${3|Must,May|} ${4:Symbol}",
      "  gen  (${5:Assign x _}) = [${6:x}]",
      "  kill (${7:Decl x Nothing}) = [${6:x}]$0"
    ],
    "description": "Declare a gen/kill dataflow analysis over the CFG"
  },
  "PSL Lint Rule": {
    "prefix": "lint",
    "body": [
      "{-# SOURCE ref \"${1:1.0}\"; STATUS ${2|verified,reviewed,draft|}; CONFIDENCE ${3:0.95} #-}",
      "lint ${4:ruleName} :: ${5|Warning,Error,Note|}, ${6|Correctness,Style,Performance,Security|}",
      "  match (${7:Pattern})",
      "  when  ${8:True}",
      "  say   \"${9:Diagnostic message}\"",
      "  fix   \"${10:Suggested fix}\" Safe (${11:replace (nameSpan x) x})$0"
    ],
    "description": "Declare a PSL lint rule with provenance pragma, match, when, say, and fix"
  },
  "PSL Lint Example Block": {
    "prefix": "psem-example",
    "body": [
      "example ${1:lintName}",
      "  fires  \"${2:bad input}\"",
      "  silent \"${3:good input}\"$0"
    ],
    "description": "Declare positive (fires) and negative (silent) examples for a PSL lint rule"
  },
  "PSL Profile Declaration": {
    "prefix": "profile",
    "body": [
      "profile ${1|default,ci,recommended,strict|} = [${2:lintRule1, lintRule2}]$0"
    ],
    "description": "Declare a named lint profile set"
  },
  "PSL Provenance & Status Pragma": {
    "prefix": "status",
    "body": [
      "{-# SOURCE ${1:ref} \"${2:section}\"; STATUS ${3|verified,reviewed,draft|}; CONFIDENCE ${4:0.95} #-}$0"
    ],
    "description": "Insert a PSL provenance and verification status pragma"
  }
}
