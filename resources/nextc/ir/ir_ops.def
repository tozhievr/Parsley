/* X(name, mnemonic, flags)
 * flags: D = defines a value, T = terminator, S = has side effects,
 *        P = pure (may be deleted when unused) */
X(ICONST,  "iconst",  D | P)
X(FCONST,  "fconst",  D | P)
X(PARAM,   "param",   D | P)
X(SYMADDR, "symaddr", D | P)
X(ALLOCA,  "alloca",  D | P)
X(ADD,     "add",     D | P)
X(SUB,     "sub",     D | P)
X(MUL,     "mul",     D | P)
X(SDIV,    "sdiv",    D | S)
X(UDIV,    "udiv",    D | S)
X(SREM,    "srem",    D | S)
X(UREM,    "urem",    D | S)
X(AND,     "and",     D | P)
X(OR,      "or",      D | P)
X(XOR,     "xor",     D | P)
X(SHL,     "shl",     D | P)
X(LSHR,    "lshr",    D | P)
X(ASHR,    "ashr",    D | P)
X(FADD,    "fadd",    D | P)
X(FSUB,    "fsub",    D | P)
X(FMUL,    "fmul",    D | P)
X(FDIV,    "fdiv",    D | P)
X(FNEG,    "fneg",    D | P)
X(ICMP,    "icmp",    D | P)
X(FCMP,    "fcmp",    D | P)
X(SELECT,  "select",  D | P)
X(ZEXT,    "zext",    D | P)
X(SEXT,    "sext",    D | P)
X(TRUNC,   "trunc",   D | P)
X(SITOFP,  "sitofp",  D | P)
X(UITOFP,  "uitofp",  D | P)
X(FPTOSI,  "fptosi",  D | P)
X(FPTOUI,  "fptoui",  D | P)
X(FPEXT,   "fpext",   D | P)
X(FPTRUNC, "fptrunc", D | P)
X(BITCAST, "bitcast", D | P)
X(LOAD,    "load",    D | S)
X(STORE,   "store",   S)
X(MEMCPY,  "memcpy",  S)
X(MEMSET,  "memset",  S)
X(XCHG,    "xchg",    D | S)
X(XADD,    "xadd",    D | S)
X(CAS,     "cas",     D | S)
X(FENCE,   "fence",   S)
X(STACKSAVE, "stacksave", D | S)
X(STACKRESTORE, "stackrestore", S)
X(DYNALLOCA, "dynalloca", D | S)
X(VAAREA,  "vaarea",  D | S)
X(CALL,    "call",    D | S)
X(PHI,     "phi",     D | P)
X(BR,      "br",      T)
X(CONDBR,  "condbr",  T)
X(RET,     "ret",     T)
X(UNREACHABLE, "unreachable", T)
