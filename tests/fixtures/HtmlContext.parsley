module HtmlContext (program) where

import Parsley.Prelude (many, eof)

-- Лексика ---------------------------------------------
skip ws = /[[:space:]]+/
token openTag = "<" -> push tag
token closeTag = "</" -> push tag
token textContent = /[^<]+/ :: Text

mode tag where
  token ident = /[a-zA-Z_][a-zA-Z0-9_-]*/ :: Text
  token tagEnd = ">" -> pop

-- AST -------------------------------------------------
data Node
  = Elem Text [Node]
  | TextNode Text

-- Синтаксис -------------------------------------------
program :: Node
program = htmlTag <* eof

node :: Node
node
  = htmlTag
  | TextNode <$> textContent

htmlTag :: Node
htmlTag = context do
  name <- openTag *> ident <* tagEnd
  body <- many node
  closeTag *> exactly name <* tagEnd
  pure (Elem name body)

-- Примеры ---------------------------------------------
example "html" : "<div>hello</div>" parses-to Elem "div" [TextNode "hello"]
