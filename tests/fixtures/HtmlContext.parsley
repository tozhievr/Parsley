module HtmlContext (program) where

import Parsley.Prelude (many, eof)

-- Лексика ---------------------------------------------
skip  ws          = /[[:space:]]+/
token ident       = /[a-zA-Z_][a-zA-Z0-9_-]*/ :: Text
token textContent = /[^<]+/                    :: Text

-- AST -------------------------------------------------
data Node
  = Elem Text [Node]
  | TextNode Text

-- Синтаксис -------------------------------------------
program :: Node
program = htmlTag <* eof

node :: Node
node
  = htmlTag
  | TextNode <$> textContent

htmlTag :: Node
htmlTag = context do
  name <- "<" *> ident <* ">"
  body <- many node
  "</" *> exactly name <* ">"
  pure (Elem name body)

-- Примеры ---------------------------------------------
example "html" : "<div>hello</div>" parses-to Elem "div" [TextNode "hello"]
