module Mini (program) where

import Parsley.Prelude (sepBy, many, eof)

-- Lexical rules -------------------------------------------------
skip  ws      = /[[:space:]]+/
skip  comment = /\/\/[^\n]*/
token number  = /[0-9]+/ :: Double
token ident   = /[a-zA-Z_][a-zA-Z0-9_]*/ :: Text
keywords = ["let", "if", "else", "while", "return", "break", "continue"]

-- AST -----------------------------------------------------------
data MiniOp
  = Add
  | Sub
  | Mul
  | Div
  | Eq
  | Neq
  | Lt
  | Gt

data MiniExpr
  = IntLit Double
  | ReadVar Text
  | Bin MiniOp MiniExpr MiniExpr
  | Neg MiniExpr

data MiniStmt
  = Seq [MiniStmt]
  | DeclVar Text [MiniExpr]
  | Assign Text MiniExpr
  | If MiniExpr MiniStmt MiniStmt
  | While MiniExpr MiniStmt
  | Return MiniExpr
  | Break
  | Continue
  | ExprStmt MiniExpr

-- Grammar -------------------------------------------------------
program :: MiniStmt
program = do
  ss <- many stmt
  eof
  pure (Seq ss)

block :: MiniStmt
block = do
  "{"
  ss <- many stmt
  "}"
  pure (Seq ss)

optInit :: [MiniExpr]
optInit
  =  do
    "="
    e <- expr
    pure [e]
  |  do
    pure []

optElse :: MiniStmt
optElse
  =  "else" *> stmt
  |  do
    pure (Seq [])

stmt :: MiniStmt
stmt
  =  block
  |  declStmt
  |  ifStmt
  |  whileStmt
  |  returnStmt
  |  ("break" *> ";" *> pure Break)
  |  ("continue" *> ";" *> pure Continue)
  |  assignStmt
  |  (ExprStmt <$> expr <* ";")

declStmt :: MiniStmt
declStmt = do
  "let"
  name <- ident
  init <- optInit
  ";"
  pure (DeclVar name init)

assignStmt :: MiniStmt
assignStmt = do
  name <- ident
  "="
  rhs  <- expr
  ";"
  pure (Assign name rhs)

ifStmt :: MiniStmt
ifStmt = do
  "if"
  cond   <- parens expr
  thenBr <- stmt
  elseBr <- optElse
  pure (If cond thenBr elseBr)

whileStmt :: MiniStmt
whileStmt = do
  "while"
  cond <- parens expr
  body <- stmt
  pure (While cond body)

returnStmt :: MiniStmt
returnStmt = do
  "return"
  e <- expr
  ";"
  pure (Return e)

expr :: MiniExpr
expr = operators atom
  [ infix 4 ["==" => Bin Eq, "!=" => Bin Neq, "<" => Bin Lt, ">" => Bin Gt]
  , infixl 6 ["+" => Bin Add, "-" => Bin Sub]
  , infixl 7 ["*" => Bin Mul, "/" => Bin Div]
  , prefix 8 ["-" => Neg]
  ]

atom :: MiniExpr
atom
  =  IntLit <$> number
  |  ReadVar <$> ident
  |  parens expr

parens :: Rule a -> Rule a
parens p = "(" *> p <* ")"

-- Examples ------------------------------------------------------
example "decl_and_assign" : "let x; x = 1; return x;" parses-to Seq [DeclVar "x" [], Assign "x" (IntLit 1), Return (ReadVar "x")]
example "if_else" : "let x = 0; if (x < 5) { x = x + 1; } else { x = 10; }" parses-to Seq [DeclVar "x" [IntLit 0], If (Bin Lt (ReadVar "x") (IntLit 5)) (Seq [Assign "x" (Bin Add (ReadVar "x") (IntLit 1))]) (Seq [Assign "x" (IntLit 10)])]
example "while_loop" : "let i = 0; while (i < 3) { i = i + 1; } return i;" parses-to Seq [DeclVar "i" [IntLit 0], While (Bin Lt (ReadVar "i") (IntLit 3)) (Seq [Assign "i" (Bin Add (ReadVar "i") (IntLit 1))]), Return (ReadVar "i")]
example "err_semi" : "let x = 1 + ;" fails-at (1, 13) expecting "expression"
