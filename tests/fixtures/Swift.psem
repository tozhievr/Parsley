{-# LANGUAGE Sem1 #-}
semantics Swift where

import Swift
import Parsley.Sem.Prelude

{-# SOURCE swiftRef "The Swift Programming Language 5.9" "2024-02-01" #-}
source swiftRef = manual "The Swift Programming Language" rev "5.9"

-- Типы и виды символов ---------------------------------------------------
tycon SwInt
tycon SwDouble
tycon SwString
tycon SwBool
tycon SwVoid
tycon SwArrayTy a
tycon SwFnTy a b
tycon SwErrTy

type Number = SwDouble

kind Variable where shadowing = Warn
kind Function
kind TypeDecl

{-# SOURCE swiftRef "Standard Library / print"; STATUS verified; CONFIDENCE 0.98 #-}
builtin print :: forall a. Function (a -> SwVoid)
{-# SOURCE swiftRef "Standard Library / abs"; STATUS verified; CONFIDENCE 0.98 #-}
builtin abs   :: Function (SwInt -> SwInt)
{-# SOURCE swiftRef "Standard Library / max"; STATUS verified; CONFIDENCE 0.98 #-}
builtin max   :: Function (SwInt -> SwInt -> SwInt)

-- Каталог диагностик -----------------------------------------------------
diag E_UNDECLARED  :: Error "Cannot find `{name}` in scope"
diag E_REDECLARED  :: Error "Invalid redeclaration of `{name}`"
diag E_TYPE        :: Error "Type mismatch: expected `{expected}`, got `{actual}`"
diag W_DIV_ZERO    :: Warning "Division by zero"
diag W_MOD_ZERO    :: Warning "Remainder by zero"
diag W_UNUSED_LET  :: Warning "Immutable value `{name}` was never used"
diag W_VAR_MUTABLE :: Warning "Variable `{name}` was never mutated; consider changing to `let`"
diag W_USE_UNINIT  :: Error "Variable `{name}` used before initialization"
diag W_UNREACHABLE :: Warning "Code after `return` will never be executed"

-- Семантические уравнения (Pass 1–3) -------------------------------------
{-# SOURCE swiftRef "Lexical Structure / Literals"; STATUS verified; CONFIDENCE 0.98 #-}
node SwNum _ where
  type = SwDouble

{-# SOURCE swiftRef "Lexical Structure / String literals"; STATUS verified; CONFIDENCE 0.98 #-}
node SwStr _ where
  type = SwString

{-# SOURCE swiftRef "Lexical Structure / Boolean literals"; STATUS verified; CONFIDENCE 0.98 #-}
node SwBool _ where
  type = SwBool

{-# SOURCE swiftRef "Lexical Structure / Nil literal"; STATUS verified; CONFIDENCE 0.98 #-}
node SwNil where
  type = SwVoid

{-# SOURCE swiftRef "Expressions / Primary expressions"; STATUS verified; CONFIDENCE 0.97 #-}
node SwVar x where
  sym  <- lookup Variable x `orFail` E_UNDECLARED { name = x }
  type =  typeOf sym

{-# SOURCE swiftRef "Expressions / Prefix operators"; STATUS verified; CONFIDENCE 0.96 #-}
node SwUnary _ e where
  type = typeOf e

{-# SOURCE swiftRef "Expressions / Binary operators"; STATUS verified; CONFIDENCE 0.96 #-}
node SwBin _ l r where
  unify (typeOf l) (typeOf r)
    `orFail` E_TYPE { expected = typeOf l, actual = typeOf r }
  type = typeOf l

{-# SOURCE swiftRef "Expressions / Collection literals"; STATUS verified; CONFIDENCE 0.95 #-}
node SwArray _ where
  a <- fresh
  type = SwArrayTy a

{-# SOURCE swiftRef "Expressions / Function calls"; STATUS verified; CONFIDENCE 0.95 #-}
node SwCall f _ where
  r <- fresh
  type = r

{-# SOURCE swiftRef "Expressions / Member access"; STATUS verified; CONFIDENCE 0.94 #-}
node SwMember obj _ where
  type = SwVoid

{-# SOURCE swiftRef "Declarations / Constant Declaration"; STATUS verified; CONFIDENCE 0.97 #-}
node StmtLet name _ val where
  declare Variable name (generalize (typeOf val))
  type = SwVoid

{-# SOURCE swiftRef "Declarations / Variable Declaration"; STATUS verified; CONFIDENCE 0.97 #-}
node StmtVar name _ val where
  declare Variable name (generalize (typeOf val))
  type = SwVoid

{-# SOURCE swiftRef "Statements / Return"; STATUS verified; CONFIDENCE 0.97 #-}
node StmtReturn _ where
  type = SwVoid

{-# SOURCE swiftRef "Declarations / Function Declaration"; STATUS verified; CONFIDENCE 0.96 #-}
node DeclFunc name _ _ body where
  retTy <- fresh
  declare Function name (generalize retTy)
  scope body $ declare Variable "self" SwVoid
  type = retTy

{-# SOURCE swiftRef "Declarations / Structure Declaration"; STATUS verified; CONFIDENCE 0.96 #-}
node DeclStruct name members where
  declare TypeDecl name SwVoid
  scope members $ declare Variable "self" SwVoid
  type = SwVoid

{-# SOURCE swiftRef "Declarations / Class Declaration"; STATUS verified; CONFIDENCE 0.96 #-}
node DeclClass name _ members where
  declare TypeDecl name SwVoid
  scope members $ declare Variable "self" SwVoid
  type = SwVoid

{-# SOURCE swiftRef "Declarations / Enumeration Declaration"; STATUS verified; CONFIDENCE 0.96 #-}
node DeclEnum name _ where
  declare TypeDecl name SwVoid
  type = SwVoid

{-# SOURCE swiftRef "Declarations / Top-level code"; STATUS verified; CONFIDENCE 0.98 #-}
node SwFile _ where
  type = SwVoid

-- Граф потока управления и анализ данных (Pass 4) ------------------------
flow SwFile ds        = chain ds
flow StmtIf c t e     = branch c [t, e]
flow StmtGuard c e    = branch c [e]
flow StmtWhile c body = loop c body
flow StmtFor _ it b   = loop it b
flow StmtReturn es    = jump es Exit

{-# SOURCE swiftRef "Control Flow / Definite Initialization"; STATUS verified; CONFIDENCE 0.96 #-}
analysis swAssigned :: Forward, Must Symbol
  gen (StmtLet x _ _)    = [x]
  gen (StmtVar x _ _)    = [x]
  gen (DeclFunc f _ _ _) = [f]
  gen (StmtFor x _ _)    = [x]

{-# SOURCE swiftRef "Declarations / Mutation tracking"; STATUS verified; CONFIDENCE 0.96 #-}
analysis swMutated :: Backward, May Symbol
  gen (SwBin SwAssign (SwVar x) _) = [x]

-- Правила линтинга и обязательные примеры (Pass 5) -----------------------
{-# SOURCE swiftRef "Expressions / Arithmetic Operators"; STATUS verified; CONFIDENCE 0.99 #-}
lint divByZero :: Error, Correctness
  match (SwBin SwDiv _ r)
  when  constFold r == Just 0
  say   "Division by zero"

example divByZero
  fires  "let x = 10 / 0"
  fires  "let y = 4 / (2 - 2)"
  silent "let x = 10 / 2"

{-# SOURCE swiftRef "Expressions / Remainder Operator"; STATUS verified; CONFIDENCE 0.99 #-}
lint modByZero :: Error, Correctness
  match (SwBin SwMod _ r)
  when  constFold r == Just 0
  say   "Remainder by zero"

example modByZero
  fires  "let x = 10 % 0"
  silent "let x = 10 % 3"

{-# SOURCE swiftRef "Declarations / Constant Declaration"; STATUS verified; CONFIDENCE 0.95 #-}
lint unusedLet :: Warning, Style
  match (StmtLet x _ _)
  when  useCount x == 0 && not ("_" `isPrefixOf` x)
  say   "Immutable value `{x}` was never used"
  fix   "Replace with wildcard `_`" Safe (replace (nameSpan x) "_")

example unusedLet
  fires  "let unused = 42"
  silent "let used = 42\nprint(used + 1)"
  silent "let _ignored = 42"

{-# SOURCE swiftRef "Declarations / Variable Declaration"; STATUS verified; CONFIDENCE 0.94 #-}
lint neverMutatedVar :: Warning, Style
  match (StmtVar x _ _)
  when  x `notMember` after swMutated
  say   "Variable `{x}` was never mutated; consider changing to `let`"
  fix   "Consider replacing `var` with `let`" Safe (replace (nameSpan x) x)

example neverMutatedVar
  fires  "func f() { var count = 1 }"
  silent "func f() { var count = 1; count = 2 }"

{-# SOURCE swiftRef "Control Flow / Definite Initialization"; STATUS verified; CONFIDENCE 0.94 #-}
lint useBeforeInit :: Error, Correctness
  match (SwVar x)
  when  x `notMember` before swAssigned
  say   "Variable `{x}` used before initialization"

example useBeforeInit
  fires  "func f() -> Int { let y = uninit + 1; return y }"
  silent "func f() -> Int { let initVal = 1; let y = initVal + 1; return y }"

{-# SOURCE swiftRef "Statements / Control Transfer"; STATUS verified; CONFIDENCE 0.93 #-}
lint unreachableCode :: Warning, Correctness
  match (s :: SwiftStmt)
  when  not (reachable s)
  say   "Code after `return` will never be executed"

example unreachableCode
  fires  "func f(x: Int) -> Int { return x; let dead = 1 }"
  silent "func f(x: Int) -> Int { let live = x + 1; return live }"

-- Профили сборки ---------------------------------------------------------
profile default = [divByZero, modByZero, unusedLet, neverMutatedVar, useBeforeInit, unreachableCode]
profile ci      = [divByZero, modByZero, useBeforeInit, unreachableCode]
