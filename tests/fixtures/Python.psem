{-# LANGUAGE Sem1 #-}
semantics Python where

import Python
import Parsley.Sem.Prelude

{-# SOURCE pyRef "Python 3.12 Language Reference" "2024-01-15" #-}
source pyRef = manual "Python 3 Language Reference" rev "3.12"

-- Типы и виды символов ---------------------------------------------------
tycon PyNumber
tycon PyStrTy
tycon PyBoolTy
tycon PyNoneTy
tycon PyListTy a
tycon PyFnTy a b
tycon PyAnyTy
tycon PyErrTy

type Number = PyNumber

kind Variable where shadowing = Warn
kind Function
kind Class

{-# SOURCE pyRef "Built-in Functions / len"; STATUS verified; CONFIDENCE 0.98 #-}
builtin len   :: forall a. Function (PyListTy a -> PyNumber)
{-# SOURCE pyRef "Built-in Functions / abs"; STATUS verified; CONFIDENCE 0.98 #-}
builtin abs   :: Function (PyNumber -> PyNumber)
{-# SOURCE pyRef "Built-in Functions / print"; STATUS verified; CONFIDENCE 0.98 #-}
builtin print :: forall a. Function (a -> PyNoneTy)
{-# SOURCE pyRef "Built-in Functions / range"; STATUS verified; CONFIDENCE 0.98 #-}
builtin range :: Function (PyNumber -> PyListTy PyNumber)

-- Каталог диагностик -----------------------------------------------------
diag E_UNDECLARED  :: Error "Undefined variable or symbol `{name}`"
diag E_REDECLARED  :: Error "Symbol `{name}` is already defined in this scope"
diag E_TYPE        :: Error "Type mismatch: expected `{expected}`, got `{actual}`"
diag W_DIV_ZERO    :: Warning "Division by zero"
diag W_FLOOR_ZERO  :: Warning "Integer floor division by zero"
diag W_EMPTY_PASS  :: Warning "Redundant `pass` statement"
diag W_UNUSED_VAR  :: Warning "Variable `{name}` is assigned but never used"
diag W_USE_UNINIT  :: Error "Variable `{name}` may be used before assignment"
diag W_UNREACHABLE :: Warning "Unreachable statement"

-- Семантические уравнения (Pass 1–3) -------------------------------------
{-# SOURCE pyRef "Expressions / Literals"; STATUS verified; CONFIDENCE 0.98 #-}
node PyNum _ where
  type = PyNumber

{-# SOURCE pyRef "Expressions / String literals"; STATUS verified; CONFIDENCE 0.98 #-}
node PyStr _ where
  type = PyStrTy

{-# SOURCE pyRef "Expressions / Booleans"; STATUS verified; CONFIDENCE 0.98 #-}
node PyBool _ where
  type = PyBoolTy

{-# SOURCE pyRef "Expressions / None"; STATUS verified; CONFIDENCE 0.98 #-}
node PyNone where
  type = PyNoneTy

{-# SOURCE pyRef "Expressions / Identifiers"; STATUS verified; CONFIDENCE 0.97 #-}
node PyVar x where
  sym  <- lookup Variable x `orFail` E_UNDECLARED { name = x }
  type =  typeOf sym

{-# SOURCE pyRef "Expressions / Unary"; STATUS verified; CONFIDENCE 0.96 #-}
node PyUnary _ e where
  type = typeOf e

{-# SOURCE pyRef "Expressions / Binary"; STATUS verified; CONFIDENCE 0.96 #-}
node PyBin _ l r where
  unify (typeOf l) (typeOf r)
    `orFail` E_TYPE { expected = typeOf l, actual = typeOf r }
  type = typeOf l

{-# SOURCE pyRef "Expressions / Lists"; STATUS verified; CONFIDENCE 0.95 #-}
node PyList _ where
  a <- fresh
  type = PyListTy a

{-# SOURCE pyRef "Expressions / Calls"; STATUS verified; CONFIDENCE 0.95 #-}
node PyCall f _ where
  r <- fresh
  type = r

{-# SOURCE pyRef "Expressions / Subscriptions"; STATUS verified; CONFIDENCE 0.95 #-}
node PyIndex arr _ where
  elemTy <- fresh
  unify (typeOf arr) (PyListTy elemTy)
    `orFail` E_TYPE { expected = PyListTy elemTy, actual = typeOf arr }
  type = elemTy

{-# SOURCE pyRef "Expressions / Attribute references"; STATUS verified; CONFIDENCE 0.94 #-}
node PyAttr obj _ where
  type = PyAnyTy

{-# SOURCE pyRef "Simple statements / Assignment"; STATUS verified; CONFIDENCE 0.96 #-}
node PyAssign (PyVar x) _ val where
  declare Variable x (generalize (typeOf val))
  type = typeOf val

{-# SOURCE pyRef "Simple statements / Augmented assignment"; STATUS verified; CONFIDENCE 0.96 #-}
node PyAugAssign (PyVar x) _ val where
  sym <- lookup Variable x `orFail` E_UNDECLARED { name = x }
  unify (typeOf sym) (typeOf val)
    `orFail` E_TYPE { expected = typeOf sym, actual = typeOf val }
  type = typeOf sym

{-# SOURCE pyRef "Compound statements / Function definitions"; STATUS verified; CONFIDENCE 0.96 #-}
node PyDef name _ _ body where
  retTy <- fresh
  declare Function name (generalize retTy)
  scope body $ declare Variable "self" PyAnyTy
  type = retTy

{-# SOURCE pyRef "Compound statements / Class definitions"; STATUS verified; CONFIDENCE 0.96 #-}
node PyClass name _ body where
  declare Class name PyAnyTy
  scope body $ declare Variable "self" PyAnyTy
  type = PyAnyTy

{-# SOURCE pyRef "Compound statements / For statements"; STATUS verified; CONFIDENCE 0.96 #-}
node PyFor var _ body where
  elemTy <- fresh
  scope body $ declare Variable var (mono elemTy)
  type = PyNoneTy

{-# SOURCE pyRef "Simple statements / Return"; STATUS verified; CONFIDENCE 0.97 #-}
node PyReturn e where
  type = typeOf e

{-# SOURCE pyRef "Top-level / Modules"; STATUS verified; CONFIDENCE 0.98 #-}
node PyModule _ where
  type = PyNoneTy

-- Граф потока управления и анализ данных (Pass 4) ------------------------
flow PyModule ss    = chain ss
flow PyIf c t e     = branch c [t, e]
flow PyWhile c body = loop c body
flow PyFor _ it b   = loop it b
flow PyReturn e     = jump e Exit
flow PyBreak        = jumpOut (enclosing PyWhile)
flow PyContinue     = jumpTo  (enclosing PyWhile)

{-# SOURCE pyRef "Execution model / Binding of names"; STATUS verified; CONFIDENCE 0.96 #-}
analysis pyAssigned :: Forward, Must Symbol
  gen (PyAssign (PyVar x) _ _) = [x]
  gen (PyDef f _ _ _)           = [f]
  gen (PyClass c _ _)           = [c]
  gen (PyFor x _ _)             = [x]

{-# SOURCE pyRef "Execution model / Liveness"; STATUS verified; CONFIDENCE 0.96 #-}
analysis pyLive :: Backward, May Symbol
  gen  (PyVar x)                = [x]
  kill (PyAssign (PyVar x) _ _) = [x]

-- Правила линтинга и обязательные примеры (Pass 5) -----------------------
{-# SOURCE pyRef "Expressions / Binary arithmetic (6.7)"; STATUS verified; CONFIDENCE 0.99 #-}
lint divByZero :: Error, Correctness
  match (PyBin PyDiv _ r)
  when  constFold r == Just 0
  say   "Division by zero"

example divByZero
  fires  "x = 10 / 0"
  fires  "y = 4 / (2 - 2)"
  silent "x = 10 / 2"

{-# SOURCE pyRef "Expressions / Floor division (6.7)"; STATUS verified; CONFIDENCE 0.99 #-}
lint floorDivByZero :: Error, Correctness
  match (PyBin PyFloorDiv _ r)
  when  constFold r == Just 0
  say   "Integer floor division by zero"

example floorDivByZero
  fires  "x = 10 // 0"
  silent "x = 10 // 3"

{-# SOURCE pyRef "Simple statements / pass (7.4)"; STATUS verified; CONFIDENCE 0.92 #-}
lint emptyPass :: Warning, Style
  match (PyPass)
  when  True
  say   "Redundant `pass` statement"

example emptyPass
  fires  "if x > 0: pass"
  silent "if x > 0: return 1"

{-# SOURCE pyRef "Execution model / Naming (4.2)"; STATUS verified; CONFIDENCE 0.95 #-}
lint unusedVar :: Warning, Style
  match (PyAssign (PyVar x) _ _)
  when  useCount x == 0 && not ("_" `isPrefixOf` x)
  say   "Variable `{x}` is assigned but never used"
  fix   "Prefix with underscore" Safe (replace (nameSpan x) ("_" <> x))

example unusedVar
  fires  "unused = 42"
  silent "used = 42\nprint(used + 1)"
  silent "_ignored = 42"

{-# SOURCE pyRef "Execution model / Resolution of names (4.2.2)"; STATUS verified; CONFIDENCE 0.94 #-}
lint useBeforeAssign :: Error, Correctness
  match (PyVar x)
  when  x `notMember` before pyAssigned
  say   "Variable `{x}` may be used before assignment"

example useBeforeAssign
  fires  "y = missing + 1"
  silent "defined = 1\ny = defined + 1"

{-# SOURCE pyRef "Simple statements / return (7.6)"; STATUS verified; CONFIDENCE 0.93 #-}
lint unreachableStmt :: Warning, Correctness
  match (s :: PyStmt)
  when  not (reachable s)
  say   "Unreachable statement"

example unreachableStmt
  fires  "def f(x): return x\ny = 1"
  silent "def f(x): y = x + 1\nreturn y"

-- Профили сборки ---------------------------------------------------------
profile default = [divByZero, floorDivByZero, emptyPass, unusedVar, useBeforeAssign, unreachableStmt]
profile ci      = [divByZero, floorDivByZero, useBeforeAssign, unreachableStmt]
