{-# LANGUAGE Sem1 #-}
semantics Kotlin where

import Kotlin
import Parsley.Sem.Prelude
import Kotlin.Lints

source kotlinSpec = manual "Kotlin Language Specification" rev "1.9-rfc+0.1"

-- Типы и символы -------------------------------------------------
type KtTy = KtInt | KtDouble | KtString | KtBool | KtUnit | KtNull | KtAny | KtErr

kind Variable where shadowing = Warn
kind Function
kind TypeName
kind Constructor
kind TypeAlias

{-# SOURCE kotlinSpec "builtins/stdlib" "2026-01-15" #-}
builtin println :: Function (KtAny -> KtUnit)
{-# SOURCE kotlinSpec "builtins/stdlib" "2026-01-15" #-}
builtin readln  :: Function (KtUnit -> KtString)
{-# SOURCE kotlinSpec "builtins/stdlib" #-}
builtin Error :: Function (KtUnit -> KtAny)
{-# SOURCE kotlinSpec "builtins/stdlib" #-}
builtin run :: Function (KtAny -> KtAny)
{-# SOURCE kotlinSpec "builtins/stdlib/arrayOf" #-}
builtin arrayOf :: Function (KtAny -> KtAny)

-- Диагностики ----------------------------------------------------
diag E_UNDECLARED   :: Error "Unresolved reference: `{name}`"
diag E_REDECLARED   :: Error "Conflicting declarations: `{name}`"
diag E_TYPE         :: Error "Type mismatch: expected `{expected}`, got `{actual}`"
diag E_VAL_REASSIGN :: Error "`val` `{name}` cannot be reassigned"
diag W_DIV_ZERO     :: Warning "Division or modulo by constant zero"
diag W_DEAD_CODE    :: Warning "Unreachable statement after `return`"

-- Правила для узлов AST ------------------------------------------
{-# SOURCE kotlinSpec "expressions/integer-literals" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node IntLit n where
  type = KtInt
  value = i32Literal n
  effects = []

{-# SOURCE kotlinSpec "expressions/integer-literals" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node HexLit _ where
  type = KtInt

{-# SOURCE kotlinSpec "expressions/integer-literals" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node BinaryLit _ where
  type = KtInt

{-# SOURCE kotlinSpec "expressions/real-literals" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node FloatLit n where
  type = KtDouble
  value = n
  effects = []

{-# SOURCE kotlinSpec "expressions/string-literals" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node StrLit text where
  type = KtString
  value = cstrQuoted text
  effects = []

{-# SOURCE kotlinSpec "expressions/boolean-literals" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node BoolLit literal where
  type = KtBool
  value = literal
  effects = []

node NullLit where
  type = KtNull

node Var x where
  sym  <- lookup Variable x `orFail` E_UNDECLARED { name = x }
  type =  typeOf sym

{-# SOURCE kotlinSpec "overload-resolution/building-the-overload-candidate-set" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node CallReceiver name where
  value <- lookup Variable name
  qualifier <- lookup TypeName name
  require (isResolved value || isResolved qualifier) `orFail` E_UNDECLARED { name = name }
  type = if isResolved value then typeOf value else typeOf qualifier

{-# SOURCE kotlinSpec "expressions/try-expressions" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node CatchClause name _ body where
  scope body $ declare Variable name KtAny
  type = KtUnit

{-# SOURCE kotlinSpec "expressions/lambda-literals" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node LambdaExpr _ body _ where
  scope body $ pure ()
  type = KtAny

{-# SOURCE kotlinSpec "expressions/lambda-literals" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node LambdaParameter name _ where
  declare Variable name KtAny
  type = KtUnit

{-# SOURCE kotlinSpec "expressions/type-checking-expressions" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node TypeTestChain _ _ where
  type = KtBool

{-# SOURCE kotlinSpec "expressions/conditional-expressions" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node IfExpr condition whenTrue whenFalse where
  nativeSelect = selectSingletons condition whenTrue whenFalse

{-# SOURCE kotlinSpec "expressions/conditional-expressions" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node IfStmt condition whenTrue whenFalse where
  nativeSelect = selectSingletons condition whenTrue whenFalse

{-# SOURCE kotlinSpec "statements" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node ExprStmt result where
  value = valueOf result
  effects = []

{-# SOURCE kotlinSpec "expressions/prefix-expressions" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node Unary op e where
  nativeI32 = i32Negation op e Neg
  type = if op == Not then KtBool else typeOf e

{-# SOURCE kotlinSpec "expressions/additive-expressions" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node Bin op l r where
  nativeI32 = i32Binary op l r [Add, Sub, Mul]
  nativeCompare = i32Comparison op l r [Eq, Neq, Lt, Le, Gt, Ge]
  require ((op /= Div && op /= Mod) || constFold r /= Just 0) `orFail` W_DIV_ZERO
  type = if op == Eq || op == Neq || op == Lt || op == Gt || op == Le || op == Ge || op == And || op == Or
         then KtBool
         else if op == RangeUntil then KtAny else typeOf l

node Call f args where
  fn <- lookup Function f
  classifier <- lookup Constructor f
  alias <- lookup TypeAlias f
  require (isResolved fn || isResolved classifier || isResolved alias) `orFail` E_UNDECLARED { name = f }
  type = if isResolved fn then typeOf fn else if isResolved classifier then typeOf classifier else typeOf alias

{-# SOURCE kotlinSpec "expressions/function-calls-and-property-access" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node GenericCall f _ args where
  fn <- lookup Function f
  classifier <- lookup Constructor f
  alias <- lookup TypeAlias f
  require (isResolved fn || isResolved classifier || isResolved alias) `orFail` E_UNDECLARED { name = f }
  type = if isResolved fn then typeOf fn else if isResolved classifier then typeOf classifier else typeOf alias

node ValStmt isVar name ty init where
  declare Variable name (if ty == "" then KtAny else KtInt)
  type = KtUnit

node AssignStmt target op rhs where
  sym <- lookup Variable target `orFail` E_UNDECLARED { name = target }
  type = KtUnit

{-# SOURCE kotlinSpec "statements/assignments" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node IndexedAssignStmt target _ _ _ where
  sym <- lookup Variable target `orFail` E_UNDECLARED { name = target }
  type = KtUnit

node PropDecl isVar name ty init where
  declare Variable name (if ty == "" then KtAny else KtInt)
  type = KtUnit

{-# SOURCE kotlinSpec "declarations/function-declaration" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
{-# SOURCE kotlinSpec "declarations/function-declaration" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node FunDecl "main" NoTypeParameters [CastType "Int" [] NoTypeArguments []] (FunctionScope _ [] [ReturnStmt [result]]) where
  predeclare Function "main" KtAny
  type = KtUnit
  entryPassive = True
  entryI32 = result

{-# SOURCE kotlinSpec "declarations/function-declaration" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node FunDecl "box" NoTypeParameters [CastType "String" [] NoTypeArguments []] (FunctionScope _ [] [ReturnStmt [result]]) where
  predeclare Function "box" KtAny
  type = KtUnit
  entryPassive = True
  entryCstr = result
  entryCstrConstructor = ["StrLit", "IfExpr"]

{-# SOURCE kotlinSpec "declarations/function-declaration" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node FunDecl "box" NoTypeParameters [] (FunctionScope [] [] [ReturnStmt [result]]) where
  predeclare Function "box" KtAny
  type = KtUnit
  entryPassive = True
  entryCstr = result
  entryCstrConstructor = "StrLit"

node FunDecl name _ _ functionScope where
  entryPassive = True
  predeclare Function name KtAny
  scope functionScope $ pure ()
  type = KtUnit

{-# SOURCE kotlinSpec "declarations/function-declaration" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node FunctionParam name ty variadic _ where
  declare Variable name (if variadic then KtAny else if ty == "Int" then KtInt else if ty == "Double" then KtDouble else if ty == "Boolean" then KtBool else if ty == "String" then KtString else KtAny)
  type = KtUnit

{-# SOURCE kotlinSpec "declarations/function-declaration" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node FunctionScope [CastType ty [] NoTypeArguments _] _ [ReturnStmt [result]] where
  require (ty /= "Int" || typeOf result /= KtString) `orFail` E_TYPE { expected = ty, actual = "String" }
  type = KtUnit

{-# SOURCE kotlinSpec "declarations/annotation-class-declaration" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node ClassDecl "annotation" name _ params members False where
  entryPassive = True
  predeclare Constructor name KtAny
  predeclare TypeName name KtAny
  scope members $ pure ()
  type = KtUnit

node ClassDecl kw name _ params members _ where
  predeclare Constructor name KtAny
  predeclare TypeName name KtAny
  scope members $ pure ()
  type = KtUnit

node InterfaceDecl name _ members where
  declare TypeName name KtAny
  scope members $ pure ()
  type = KtUnit

{-# SOURCE kotlinSpec "declarations/object-declaration" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node ObjectDecl name members where
  declare TypeName name KtAny
  scope members $ pure ()
  type = KtUnit

{-# SOURCE kotlinSpec "declarations/companion-object-declaration" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node CompanionDecl _ members where
  scope members $ pure ()
  type = KtUnit

{-# SOURCE kotlinSpec "declarations/type-alias" #-}
{-# STATUS draft #-}
{-# CONFIDENCE 0.9 #-}
node TypeAliasDecl name _ where
  predeclare TypeAlias name KtAny
  predeclare TypeName name KtAny
  type = KtUnit

node KtFile pkg decls where
  entryCandidates = decls
  scope decls $ pure ()
  type = KtUnit

-- Поток управления (CFG) -----------------------------------------
flow FunctionScope _ _ body = chain body
flow IfStmt c t e         = branch c [t, e]
flow WhenStmt _ branches  = chain branches
flow WhileStmt c body     = loop c body
flow ForStmt _ range body = loop range body
flow ReturnStmt _         = jump Empty Exit

-- Анализ потока данных (gen/kill) --------------------------------
analysis Initialized :: Forward, Must (Set Var)
  gen (ValStmt _ x _ [_]) = [x]
  gen (AssignStmt x _ _)  = [x]
  gen (PropDecl _ x _ [_]) = [x]

analysis Live :: Backward, May (Set Var)
  gen  (Var x)              = [x]
  kill (AssignStmt x "=" _) = [x]

-- Линты и обязательные примеры -----------------------------------
profile default = [divByConstZero, valReassign, unreachableAfterReturn]
profile ci      = [divByConstZero, valReassign, unreachableAfterReturn, whenWithoutElse]
