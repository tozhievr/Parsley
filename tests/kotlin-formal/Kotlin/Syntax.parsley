module Kotlin.Syntax where

import Parsley.Prelude (sepBy, many, some, optional, lookahead)
import Kotlin.Lexical
import Kotlin.SyntaxTree

optSemi :: ()
optSemi
  =  ";" *> (do
  pure ())
  |  do
    pure ()

packageHeader :: [Text]
packageHeader
  =  ("package" *> (identifier `sepBy` ".") <* optSemi)
  |  do
    pure []

modifier :: ()
modifier
  =  "data" *> (do
  pure ())
  |  "open" *> (do
  pure ())
  |  "abstract" *> (do
  pure ())
  |  "override" *> (do
  pure ())
  |  "private" *> (do
  pure ())
  |  "public" *> (do
  pure ())
  |  "internal" *> (do
  pure ())

classKind :: Text
classKind
  =  do
    "data"
    "class"
    pure "data"
  |  do
    "open"
    "class"
    pure "open"
  |  do
    "abstract"
    "class"
    pure "abstract"
  |  do
    "private"
    "class"
    pure "private"
  |  do
    "class"
    pure "class"

topLevelDecl :: KtDecl
topLevelDecl
  =  importDecl
  |  classDecl
  |  interfaceDecl
  |  (many modifier *> (funDecl <|> propDecl <|> objectDecl <|> typeAliasDecl))

objectDecl :: KtDecl
objectDecl = do
  "object"
  name    <- identifier
  _       <- optional superClause
  members <- classBody <|> do
  pure []
  optSemi
  pure (ObjectDecl name members)

typeAliasDecl :: KtDecl
typeAliasDecl = do
  "typealias"
  name   <- identifier
  "="
  target <- typeExpr
  optSemi
  pure (TypeAliasDecl name target)

importDecl :: KtDecl
importDecl = do
  "import"
  path  <- identifier `sepBy` "."
  alias <- importTail
  optSemi
  pure (ImportDecl path alias)

importTail :: Text
importTail
  =  do
    "."
    "*"
    pure "*"
  |  "as" *> identifier
  |  do
    pure ""

classDecl :: KtDecl
classDecl = do
  kind    <- classKind
  name    <- identifier
  types   <- typeParameters
  params  <- classParamList <|> (do
  pure [])
  _       <- superClause <|> (do
  pure ())
  members <- classBody <|> (do
  pure [])
  optSemi
  pure (ClassDecl kind name types params members)

superClause :: ()
superClause = do
  ":"
  _ <- identifier
  _ <- optTypeArgs
  _ <- parens (callArg `sepBy` ",") <|> (do
  pure [])
  pure ()

classParamList :: [KtParam]
classParamList = parens (classParam `sepBy` ",")

classParamMut :: Text
classParamMut
  =  do
    "val"
    pure "val"
  |  do
    "var"
    pure "var"
  |  do
    pure ""

classParam :: KtParam
classParam = do
  _    <- many modifier
  mut  <- classParamMut
  name <- identifier
  ":"
  ty   <- typeExpr
  pure (Param mut name ty)

interfaceDecl :: KtDecl
interfaceDecl = do
  _       <- many modifier
  "interface"
  name    <- identifier
  types   <- typeParameters
  members <- classBody <|> (do
  pure [])
  optSemi
  pure (InterfaceDecl name types members)

classBody :: [KtDecl]
classBody = braces (many memberDecl)

memberDecl :: KtDecl
memberDecl = many modifier *> (companionDecl <|> funDecl <|> propDecl <|> classDecl <|> interfaceDecl <|> objectDecl <|> typeAliasDecl)

companionDecl :: KtDecl
companionDecl = do
  "companion"
  "object"
  name    <- identifier <|> pure ""
  members <- classBody <|> pure []
  optSemi
  pure (CompanionDecl name members)

typeParameters :: KtTypeParams
typeParameters
  =  TypeParameters <$> ("<" *> typeParameter) <*> many ("," *> typeParameter) <* ">"
  |  pure NoTypeParameters

typeParameter :: KtTypeParam
typeParameter = do
  name   <- identifier
  bounds <- typeParameterBound
  pure (TypeParameter name bounds)

typeParameterBound :: [KtCastType]
typeParameterBound
  =  do
    ":"
    bound <- castType
    pure [bound]
  |  pure []

funDecl :: KtDecl
funDecl = do
  "fun"
  types  <- typeParameters
  name   <- identifier
  params <- parens (funParam `sepBy` ",")
  retTy  <- optRetType
  body   <- funBody
  optSemi
  pure (FunDecl name types retTy (FunctionScope retTy params body))

funParam :: KtParam
funParam = do
  variadic <- ("vararg" *> lookahead identifier *> pure True) <|> pure False
  name     <- identifier
  ":"
  ty       <- typeExpr
  default_ <- optInit
  pure (FunctionParam name ty variadic default_)

optRetType :: Text
optRetType
  =  ":" *> typeExpr
  |  do
    pure ""

funBody :: [KtStmt]
funBody
  =  block
  |  do
    "="
    e <- expr
    pure [ReturnStmt [e]]
  |  do
    pure []

isVarKw :: Bool
isVarKw
  =  do
    "var"
    pure True
  |  do
    "val"
    pure False

propDecl :: KtDecl
propDecl = do
  isVar <- isVarKw
  name  <- identifier
  ty    <- optRetType
  init  <- optInit
  optSemi
  pure (PropDecl isVar name ty init)

optInit :: [KtExpr]
optInit
  =  do
    "="
    e <- expr
    pure [e]
  |  do
    pure []

optTypeArgs :: ()
optTypeArgs
  =  do
    "<"
    _ <- typeExpr `sepBy` ","
    ">"
    pure ()
  |  do
    pure ()

optQuest :: ()
optQuest
  =  do
    "?"
    pure ()
  |  do
    pure ()

typeExpr :: Text
typeExpr = do
  base <- identifier
  _    <- optTypeArgs
  _    <- optQuest
  pure base

block :: [KtStmt]
block = braces (many stmt)

blockOrSingleStmt :: [KtStmt]
blockOrSingleStmt
  =  block
  |  do
    s <- stmt
    pure [s]

stmt :: KtStmt
stmt
  =  valStmt
  |  ifStmt
  |  whenStmt
  |  whileStmt
  |  forStmt
  |  returnStmt
  |  assignStmt
  |  (ExprStmt <$> expr <* optSemi)

valStmt :: KtStmt
valStmt = do
  isVar <- isVarKw
  name  <- identifier
  ty    <- optRetType
  init  <- optInit
  optSemi
  pure (ValStmt isVar name ty init)

assignOp :: Text
assignOp
  =  do
    "="
    pure "="
  |  do
    "+="
    pure "+="
  |  do
    "-="
    pure "-="
  |  do
    "*="
    pure "*="
  |  do
    "/="
    pure "/="

assignStmt :: KtStmt
assignStmt = do
  target <- identifier
  op     <- assignOp
  rhs    <- expr
  optSemi
  pure (AssignStmt target op rhs)

elseStmtBranch :: [KtStmt]
elseStmtBranch
  =  "else" *> blockOrSingleStmt
  |  do
    pure []

ifStmt :: KtStmt
ifStmt = do
  "if"
  cond  <- parens expr
  thenB <- blockOrSingleStmt
  elseB <- elseStmtBranch
  optSemi
  pure (IfStmt cond thenB elseB)

whenSubject :: [KtExpr]
whenSubject
  =  do
    e <- parens expr
    pure [e]
  |  do
    pure []

whenStmt :: KtStmt
whenStmt = do
  "when"
  subj     <- whenSubject
  branches <- braces (many whenBranch)
  optSemi
  pure (WhenStmt subj branches)

whenBranch :: KtWhenBranch
whenBranch
  =  do
    "else"
    "->"
    body <- blockOrSingleStmt
    optSemi
    pure (WhenElse body)
  |  do
    conds <- expr `sepBy` ","
    "->"
    body  <- blockOrSingleStmt
    optSemi
    pure (WhenBranch conds body)

whileStmt :: KtStmt
whileStmt = do
  "while"
  cond <- parens expr
  body <- blockOrSingleStmt
  optSemi
  pure (WhileStmt cond body)

forStmt :: KtStmt
forStmt = do
  "for"
  "("
  v    <- identifier
  "in"
  iter <- expr
  ")"
  body <- blockOrSingleStmt
  optSemi
  pure (ForStmt v iter body)

returnVal :: [KtExpr]
returnVal
  =  do
    e <- expr
    pure [e]
  |  do
    pure []

returnStmt :: KtStmt
returnStmt = ReturnStmt <$> ("return" *> returnVal) <* optSemi

expr :: KtExpr
expr = operators castExpr
  [ infixl 1 ["||" => Bin Or]
  , infixl 2 ["&&" => Bin And]
  , infixl 3 ["==" => Bin Eq, "!=" => Bin Neq]
  , infixl 4 ["<=" => Bin Le, ">=" => Bin Ge, "<" => Bin Lt, ">" => Bin Gt]
  , infixr 5 ["?:" => Bin Elvis]
  , infixl 6 [".." => Bin Range, "..<" => Bin RangeUntil]
  , infixl 7 ["+" => Bin Add, "-" => Bin Sub]
  , infixl 8 ["*" => Bin Mul, "/" => Bin Div, "%" => Bin Mod]
  ]

castExpr :: KtExpr
castExpr
  =  CastChain <$> prefixExpr <*> some castSuffix
  |  prefixExpr

castSuffix :: KtCast
castSuffix
  =  CheckedCast <$> ("as" *> castType)
  |  SafeCast <$> ("as?" *> castType)

castType :: KtCastType
castType = do
  first    <- identifier
  rest     <- many ("." *> identifier)
  args     <- typeArguments
  nullable <- ("?" *> pure True) <|> pure False
  pure (CastType first rest args nullable)

typeArguments :: KtTypeArgs
typeArguments
  =  presentTypeArguments
  |  pure NoTypeArguments

presentTypeArguments :: KtTypeArgs
presentTypeArguments = TypeArguments <$> ("<" *> castType) <*> many ("," *> castType) <* ">"

prefixExpr :: KtExpr
prefixExpr
  =  Unary Neg <$> ("-" *> prefixExpr)
  |  Unary Not <$> ("!" *> prefixExpr)
  |  postfixExpr

postfixExpr :: KtExpr
postfixExpr
  =  PostfixChain <$> atom <*> some postfixSuffix
  |  atom

postfixSuffix :: KtPostfix
postfixSuffix
  =  SelectSuffix True <$> ("?." *> identifier)
  |  SelectSuffix False <$> ("." *> identifier)
  |  InvokeSuffix <$> parens (callArg `sepBy` ",")
  |  IndexSuffix <$> brackets expr
  |  "!!" *> pure AssertNotNull

atom :: KtExpr
atom
  =  FloatLit <$> floatLit
  |  HexLit <$> hexLit
  |  BinaryLit <$> binaryLit
  |  IntLit <$> intLit
  |  StrLit <$> strLit
  |  BoolLit <$> boolLit
  |  ("null" *> pure NullLit)
  |  ThrowExpr <$> ("throw" *> expr)
  |  ifExpr
  |  whenExpr
  |  do
    obj  <- identifier
    "?."
    meth <- identifier
    args <- parens (callArg `sepBy` ",")
    pure (SafeMethodCall (Var obj) meth args)
  |  do
    obj <- identifier
    "?."
    fld <- identifier
    pure (SafeMember (Var obj) fld)
  |  do
    obj  <- identifier
    "."
    meth <- identifier
    args <- parens (callArg `sepBy` ",")
    pure (MethodCall (Var obj) meth args)
  |  do
    obj <- identifier
    "."
    fld <- identifier
    pure (Member (Var obj) fld)
  |  GenericCall <$> identifier <*> presentTypeArguments <*> parens (callArg `sepBy` ",")
  |  Call <$> identifier <*> parens (callArg `sepBy` ",")
  |  do
    arr <- identifier
    idx <- brackets expr
    pure (Index (Var arr) idx)
  |  Var <$> identifier
  |  parens expr

identifier :: Text
identifier
  =  ident
  |  ("vararg" *> pure "vararg")
  |  ("companion" *> pure "companion")

callArg :: KtExpr
callArg
  =  NamedArg <$> (identifier <* "=") <*> expr
  |  expr

ifExpr :: KtExpr
ifExpr = do
  "if"
  cond  <- parens expr
  thenB <- blockOrSingleStmt
  "else"
  elseB <- blockOrSingleStmt
  pure (IfExpr cond thenB elseB)

whenExpr :: KtExpr
whenExpr = do
  "when"
  subj     <- whenSubject
  branches <- braces (many whenBranch)
  pure (WhenExpr subj branches)

parens :: Rule a -> Rule a
parens p = "(" *> p <* ")"

brackets :: Rule a -> Rule a
brackets p = "[" *> p <* "]"

braces :: Rule a -> Rule a
braces p = "{" *> p <* "}"
