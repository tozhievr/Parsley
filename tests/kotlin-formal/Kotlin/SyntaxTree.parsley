module Kotlin.SyntaxTree where

-- AST (core Kotlin constructs for ISO C17 static analysis) -----
data KtOp
  = Or
  | And
  | Eq
  | Neq
  | Lt
  | Gt
  | Le
  | Ge
  | Elvis
  | Range
  | RangeUntil
  | Add
  | Sub
  | Mul
  | Div
  | Mod

data KtUnaryOp = Neg | Not

data KtExpr
  = IntLit Double
  | HexLit Text
  | BinaryLit Text
  | FloatLit Double
  | StrLit Text
  | BoolLit Bool
  | NullLit
  | Var Text
  | Bin KtOp KtExpr KtExpr
  | Unary KtUnaryOp KtExpr
  | Call Text [KtExpr]
  | GenericCall Text KtTypeArgs [KtExpr]
  | NamedArg Text KtExpr
  | SafeMember KtExpr Text
  | SafeMethodCall KtExpr Text [KtExpr]
  | Member KtExpr Text
  | MethodCall KtExpr Text [KtExpr]
  | CallReceiver Text
  | Index KtExpr KtExpr
  | PostfixChain KtExpr [KtPostfix]
  | CastChain KtExpr [KtCast]
  | TypeTestChain KtExpr [KtTypeTest]
  | ThrowExpr KtExpr
  | TryExpr [KtStmt] KtTryContinuation
  | LambdaExpr Text KtLambdaScope Text
  | IfExpr KtExpr [KtStmt] [KtStmt]
  | WhenExpr [KtExpr] [KtWhenBranch]

data KtLambdaScope
  = LambdaScope KtLambdaParams [KtStmt]

data KtLambdaParams
  = ImplicitLambdaParams
  | ExplicitLambdaParams [KtLambdaParam]

data KtLambdaParam
  = LambdaParameter Text [KtCastType]

data KtTryContinuation
  = CatchHandlers KtCatchClause [KtCatchClause] KtFinally
  | FinallyOnly [KtStmt]

data KtCatchClause
  = CatchClause Text KtCastType [KtStmt]

data KtFinally
  = NoFinally
  | FinallyBlock [KtStmt]

data KtPostfix
  = SelectSuffix Bool Text
  | InvokeSuffix [KtExpr]
  | IndexSuffix KtExpr
  | AssertNotNull
  | TrailingLambdaSuffix KtExpr

data KtCastType
  = CastType Text [Text] KtTypeArgs [Text]

data KtTypeArgs
  = NoTypeArguments
  | TypeArguments KtCastType [KtCastType]

data KtTypeTest
  = TypeTest Bool KtCastType

data KtCast
  = CheckedCast KtCastType
  | SafeCast KtCastType

data KtWhenBranch
  = WhenBranch [KtExpr] [KtStmt]
  | WhenElse [KtStmt]

data KtStmt
  = ValStmt Bool Text Text [KtExpr]
  | AssignStmt Text Text KtExpr
  | IfStmt KtExpr [KtStmt] [KtStmt]
  | WhenStmt [KtExpr] [KtWhenBranch]
  | WhileStmt KtExpr [KtStmt]
  | ForStmt Text KtExpr [KtStmt]
  | ReturnStmt [KtExpr]
  | ExprStmt KtExpr

data KtParam
  = Param Text Text Text
  | ExtendedClassParam Text Text Text Bool [KtExpr]
  | FunctionParam Text Text Bool [KtExpr]

data KtFunctionScope
  = FunctionScope [KtCastType] [KtParam] [KtStmt]

data KtTypeParam
  = TypeParameter Text [KtCastType]

data KtTypeParams
  = NoTypeParameters
  | TypeParameters KtTypeParam [KtTypeParam]

data KtDecl
  = ImportDecl [Text] Text
  | ClassDecl Text Text KtTypeParams [KtParam] [KtDecl] Bool
  | ObjectDecl Text [KtDecl]
  | TypeAliasDecl Text KtCastType
  | InterfaceDecl Text KtTypeParams [KtDecl]
  | CompanionDecl Text [KtDecl]
  | FunDecl Text KtTypeParams [KtCastType] KtFunctionScope
  | PropDecl Bool Text Text [KtExpr]

data KtFile
  = KtFile [Text] [KtDecl]
