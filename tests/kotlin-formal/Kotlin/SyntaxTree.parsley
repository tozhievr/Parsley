module Kotlin.SyntaxTree where

-- AST (core Kotlin constructs for ISO C17 static analysis) -----
data KtOp
  = Or
  | And
  | Eq
  | Neq
  | Lt
  | Gt
  | Le
  | Ge
  | Elvis
  | Range
  | RangeUntil
  | Add
  | Sub
  | Mul
  | Div
  | Mod

data KtUnaryOp = Neg | Not

data KtExpr
  = IntLit Double
  | HexLit Text
  | BinaryLit Text
  | FloatLit Double
  | StrLit Text
  | BoolLit Bool
  | NullLit
  | Var Text
  | Bin KtOp KtExpr KtExpr
  | Unary KtUnaryOp KtExpr
  | Call Text [KtExpr]
  | NamedArg Text KtExpr
  | SafeMember KtExpr Text
  | SafeMethodCall KtExpr Text [KtExpr]
  | Member KtExpr Text
  | MethodCall KtExpr Text [KtExpr]
  | Index KtExpr KtExpr
  | PostfixChain KtExpr [KtPostfix]
  | CastChain KtExpr [KtCast]
  | ThrowExpr KtExpr
  | IfExpr KtExpr [KtStmt] [KtStmt]
  | WhenExpr [KtExpr] [KtWhenBranch]

data KtPostfix
  = SelectSuffix Bool Text
  | InvokeSuffix [KtExpr]
  | IndexSuffix KtExpr
  | AssertNotNull

data KtCastType
  = CastType [Text] [KtCastType] Bool

data KtCast
  = CheckedCast KtCastType
  | SafeCast KtCastType

data KtWhenBranch
  = WhenBranch [KtExpr] [KtStmt]
  | WhenElse [KtStmt]

data KtStmt
  = ValStmt Bool Text Text [KtExpr]
  | AssignStmt Text Text KtExpr
  | IfStmt KtExpr [KtStmt] [KtStmt]
  | WhenStmt [KtExpr] [KtWhenBranch]
  | WhileStmt KtExpr [KtStmt]
  | ForStmt Text KtExpr [KtStmt]
  | ReturnStmt [KtExpr]
  | ExprStmt KtExpr

data KtParam
  = Param Text Text Text
  | FunctionParam Text Text Bool [KtExpr]

data KtFunctionScope
  = FunctionScope Text [KtParam] [KtStmt]

data KtDecl
  = ImportDecl [Text] Text
  | ClassDecl Text Text [KtParam] [KtDecl]
  | ObjectDecl Text [KtDecl]
  | TypeAliasDecl Text Text
  | InterfaceDecl Text [KtDecl]
  | FunDecl Text Text KtFunctionScope
  | PropDecl Bool Text Text [KtExpr]

data KtFile
  = KtFile [Text] [KtDecl]
