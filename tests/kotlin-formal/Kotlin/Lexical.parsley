module Kotlin.Lexical where

-- Лексика (derived from ANTLR4 KotlinLexer.g4) -----------------
skip  ws           = /[[:space:]]+/
skip  lineComment  = /\/\/[^\n]*/
skip  blockComment = /\/\*([^*]|\*+[^*\/])*\*+\//
token floatLit     = /[0-9]+[.][0-9]+/ :: Double
token intLit       = /[0-9]+/ :: Double
token strLit       = /"([^"\\]|\\.)*"/ :: Text
token ident        = /[a-zA-Z_][a-zA-Z0-9_]*/ :: Text
keywords = ["package", "import", "as", "class", "interface", "fun", "val", "var", "if", "else", "when", "while", "for", "in", "return", "true", "false", "null", "data", "open", "abstract", "override", "private", "public", "internal"]
