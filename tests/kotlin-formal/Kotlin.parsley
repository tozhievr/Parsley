module Kotlin (kotlinFile) where

import Parsley.Prelude (sepBy, many, optional, eof)

-- Лексика (derived from ANTLR4 KotlinLexer.g4) -----------------
skip  ws           = /[[:space:]]+/
skip  lineComment  = /\/\/[^\n]*/
skip  blockComment = /\/\*([^*]|\*+[^*\/])*\*+\//
token floatLit     = /[0-9]+[.][0-9]+/ :: Double
token intLit       = /[0-9]+/ :: Double
token strLit       = /"([^"\\]|\\.)*"/ :: Text
token ident        = /[a-zA-Z_][a-zA-Z0-9_]*/ :: Text
keywords = ["package", "import", "as", "class", "interface", "fun", "val", "var", "if", "else", "when", "while", "for", "in", "return", "true", "false", "null", "data", "open", "abstract", "override", "private", "public", "internal"]

-- AST (core Kotlin constructs for ISO C17 static analysis) -----
data KtOp
  = Or
  | And
  | Eq
  | Neq
  | Lt
  | Gt
  | Le
  | Ge
  | Range
  | Add
  | Sub
  | Mul
  | Div
  | Mod

data KtUnaryOp = Neg | Not

data KtExpr
  = IntLit Double
  | FloatLit Double
  | StrLit Text
  | BoolLit Bool
  | NullLit
  | Var Text
  | Bin KtOp KtExpr KtExpr
  | Unary KtUnaryOp KtExpr
  | Call Text [KtExpr]
  | Member KtExpr Text
  | MethodCall KtExpr Text [KtExpr]
  | Index KtExpr KtExpr
  | IfExpr KtExpr [KtStmt] [KtStmt]
  | WhenExpr [KtExpr] [KtWhenBranch]

data KtWhenBranch
  = WhenBranch [KtExpr] [KtStmt]
  | WhenElse [KtStmt]

data KtStmt
  = ValStmt Bool Text Text [KtExpr]
  | AssignStmt Text Text KtExpr
  | IfStmt KtExpr [KtStmt] [KtStmt]
  | WhenStmt [KtExpr] [KtWhenBranch]
  | WhileStmt KtExpr [KtStmt]
  | ForStmt Text KtExpr [KtStmt]
  | ReturnStmt [KtExpr]
  | ExprStmt KtExpr

data KtParam
  = Param Text Text Text

data KtDecl
  = ImportDecl [Text] Text
  | ClassDecl Text Text [KtParam] [KtDecl]
  | ObjectDecl Text [KtDecl]
  | TypeAliasDecl Text Text
  | InterfaceDecl Text [KtDecl]
  | FunDecl Text [KtParam] Text [KtStmt]
  | PropDecl Bool Text Text [KtExpr]

data KtFile
  = KtFile [Text] [KtDecl]

-- Синтаксис (derived from ANTLR4 KotlinParser.g4) ---------------
kotlinFile :: KtFile
kotlinFile = do
  pkg   <- packageHeader
  decls <- many topLevelDecl
  eof
  pure (KtFile pkg decls)

optSemi :: ()
optSemi
  =  ";" *> (do
  pure ())
  |  do
    pure ()

packageHeader :: [Text]
packageHeader
  =  ("package" *> (ident `sepBy` ".") <* optSemi)
  |  do
    pure []

modifier :: ()
modifier
  =  "data" *> (do
  pure ())
  |  "open" *> (do
  pure ())
  |  "abstract" *> (do
  pure ())
  |  "override" *> (do
  pure ())
  |  "private" *> (do
  pure ())
  |  "public" *> (do
  pure ())
  |  "internal" *> (do
  pure ())

classKind :: Text
classKind
  =  do
    "data"
    "class"
    pure "data"
  |  do
    "open"
    "class"
    pure "open"
  |  do
    "abstract"
    "class"
    pure "abstract"
  |  do
    "private"
    "class"
    pure "private"
  |  do
    "class"
    pure "class"

topLevelDecl :: KtDecl
topLevelDecl
  =  importDecl
  |  classDecl
  |  interfaceDecl
  |  (many modifier *> (funDecl <|> propDecl <|> objectDecl <|> typeAliasDecl))

objectDecl :: KtDecl
objectDecl = do
  "object"
  name    <- ident
  _       <- optional superClause
  members <- classBody <|> do
  pure []
  optSemi
  pure (ObjectDecl name members)

typeAliasDecl :: KtDecl
typeAliasDecl = do
  "typealias"
  name   <- ident
  "="
  target <- typeExpr
  optSemi
  pure (TypeAliasDecl name target)

importDecl :: KtDecl
importDecl = do
  "import"
  path  <- ident `sepBy` "."
  alias <- importTail
  optSemi
  pure (ImportDecl path alias)

importTail :: Text
importTail
  =  do
    "."
    "*"
    pure "*"
  |  "as" *> ident
  |  do
    pure ""

classDecl :: KtDecl
classDecl = do
  kind    <- classKind
  name    <- ident
  params  <- classParamList <|> (do
  pure [])
  _       <- superClause <|> (do
  pure ())
  members <- classBody <|> (do
  pure [])
  optSemi
  pure (ClassDecl kind name params members)

superClause :: ()
superClause = do
  ":"
  _ <- ident
  _ <- optTypeArgs
  _ <- parens (expr `sepBy` ",") <|> (do
  pure [])
  pure ()

classParamList :: [KtParam]
classParamList = parens (classParam `sepBy` ",")

classParamMut :: Text
classParamMut
  =  do
    "val"
    pure "val"
  |  do
    "var"
    pure "var"
  |  do
    pure ""

classParam :: KtParam
classParam = do
  _    <- many modifier
  mut  <- classParamMut
  name <- ident
  ":"
  ty   <- typeExpr
  pure (Param mut name ty)

interfaceDecl :: KtDecl
interfaceDecl = do
  _       <- many modifier
  "interface"
  name    <- ident
  members <- classBody <|> (do
  pure [])
  optSemi
  pure (InterfaceDecl name members)

classBody :: [KtDecl]
classBody = braces (many memberDecl)

memberDecl :: KtDecl
memberDecl = many modifier *> (funDecl <|> propDecl <|> classDecl <|> interfaceDecl <|> objectDecl <|> typeAliasDecl)

funDecl :: KtDecl
funDecl = do
  "fun"
  name   <- ident
  params <- parens (funParam `sepBy` ",")
  retTy  <- optRetType
  body   <- funBody
  optSemi
  pure (FunDecl name params retTy body)

funParam :: KtParam
funParam = do
  name <- ident
  ":"
  ty   <- typeExpr
  pure (Param "" name ty)

optRetType :: Text
optRetType
  =  ":" *> typeExpr
  |  do
    pure ""

funBody :: [KtStmt]
funBody
  =  block
  |  do
    "="
    e <- expr
    pure [ReturnStmt [e]]
  |  do
    pure []

isVarKw :: Bool
isVarKw
  =  do
    "var"
    pure True
  |  do
    "val"
    pure False

propDecl :: KtDecl
propDecl = do
  isVar <- isVarKw
  name  <- ident
  ty    <- optRetType
  init  <- optInit
  optSemi
  pure (PropDecl isVar name ty init)

optInit :: [KtExpr]
optInit
  =  do
    "="
    e <- expr
    pure [e]
  |  do
    pure []

optTypeArgs :: ()
optTypeArgs
  =  do
    "<"
    _ <- typeExpr `sepBy` ","
    ">"
    pure ()
  |  do
    pure ()

optQuest :: ()
optQuest
  =  do
    "?"
    pure ()
  |  do
    pure ()

typeExpr :: Text
typeExpr = do
  base <- ident
  _    <- optTypeArgs
  _    <- optQuest
  pure base

block :: [KtStmt]
block = braces (many stmt)

blockOrSingleStmt :: [KtStmt]
blockOrSingleStmt
  =  block
  |  do
    s <- stmt
    pure [s]

stmt :: KtStmt
stmt
  =  valStmt
  |  ifStmt
  |  whenStmt
  |  whileStmt
  |  forStmt
  |  returnStmt
  |  assignStmt
  |  (ExprStmt <$> expr <* optSemi)

valStmt :: KtStmt
valStmt = do
  isVar <- isVarKw
  name  <- ident
  ty    <- optRetType
  init  <- optInit
  optSemi
  pure (ValStmt isVar name ty init)

assignOp :: Text
assignOp
  =  do
    "="
    pure "="
  |  do
    "+="
    pure "+="
  |  do
    "-="
    pure "-="
  |  do
    "*="
    pure "*="
  |  do
    "/="
    pure "/="

assignStmt :: KtStmt
assignStmt = do
  target <- ident
  op     <- assignOp
  rhs    <- expr
  optSemi
  pure (AssignStmt target op rhs)

elseStmtBranch :: [KtStmt]
elseStmtBranch
  =  "else" *> blockOrSingleStmt
  |  do
    pure []

ifStmt :: KtStmt
ifStmt = do
  "if"
  cond  <- parens expr
  thenB <- blockOrSingleStmt
  elseB <- elseStmtBranch
  optSemi
  pure (IfStmt cond thenB elseB)

whenSubject :: [KtExpr]
whenSubject
  =  do
    e <- parens expr
    pure [e]
  |  do
    pure []

whenStmt :: KtStmt
whenStmt = do
  "when"
  subj     <- whenSubject
  branches <- braces (many whenBranch)
  optSemi
  pure (WhenStmt subj branches)

whenBranch :: KtWhenBranch
whenBranch
  =  do
    "else"
    "->"
    body <- blockOrSingleStmt
    optSemi
    pure (WhenElse body)
  |  do
    conds <- expr `sepBy` ","
    "->"
    body  <- blockOrSingleStmt
    optSemi
    pure (WhenBranch conds body)

whileStmt :: KtStmt
whileStmt = do
  "while"
  cond <- parens expr
  body <- blockOrSingleStmt
  optSemi
  pure (WhileStmt cond body)

forStmt :: KtStmt
forStmt = do
  "for"
  "("
  v    <- ident
  "in"
  iter <- expr
  ")"
  body <- blockOrSingleStmt
  optSemi
  pure (ForStmt v iter body)

returnVal :: [KtExpr]
returnVal
  =  do
    e <- expr
    pure [e]
  |  do
    pure []

returnStmt :: KtStmt
returnStmt = ReturnStmt <$> ("return" *> returnVal) <* optSemi

expr :: KtExpr
expr = operators atom
  [ infixl 1 ["||" => Bin Or]
  , infixl 2 ["&&" => Bin And]
  , infixl 3 ["==" => Bin Eq, "!=" => Bin Neq]
  , infixl 4 ["<=" => Bin Le, ">=" => Bin Ge, "<" => Bin Lt, ">" => Bin Gt]
  , infixl 5 [".." => Bin Range]
  , infixl 6 ["+" => Bin Add, "-" => Bin Sub]
  , infixl 7 ["*" => Bin Mul, "/" => Bin Div, "%" => Bin Mod]
  , prefix 8 ["-" => Unary Neg, "!" => Unary Not]
  ]

atom :: KtExpr
atom
  =  FloatLit <$> floatLit
  |  IntLit <$> intLit
  |  StrLit <$> strLit
  |  ("true" *> pure (BoolLit True))
  |  ("false" *> pure (BoolLit False))
  |  ("null" *> pure NullLit)
  |  ifExpr
  |  whenExpr
  |  do
    obj  <- ident
    "."
    meth <- ident
    args <- parens (expr `sepBy` ",")
    pure (MethodCall (Var obj) meth args)
  |  do
    obj <- ident
    "."
    fld <- ident
    pure (Member (Var obj) fld)
  |  Call <$> ident <*> parens (expr `sepBy` ",")
  |  do
    arr <- ident
    idx <- brackets expr
    pure (Index (Var arr) idx)
  |  Var <$> ident
  |  parens expr

ifExpr :: KtExpr
ifExpr = do
  "if"
  cond  <- parens expr
  thenB <- blockOrSingleStmt
  "else"
  elseB <- blockOrSingleStmt
  pure (IfExpr cond thenB elseB)

whenExpr :: KtExpr
whenExpr = do
  "when"
  subj     <- whenSubject
  branches <- braces (many whenBranch)
  pure (WhenExpr subj branches)

parens :: Rule a -> Rule a
parens p = "(" *> p <* ")"

brackets :: Rule a -> Rule a
brackets p = "[" *> p <* "]"

braces :: Rule a -> Rule a
braces p = "{" *> p <* "}"

-- Примеры и тесты ----------------------------------------------
example "fun_expr" : "fun sq(x: Int): Int = x * x" parses-to KtFile [] [FunDecl "sq" [Param "" "x" "Int"] "Int" [ReturnStmt [Bin Mul (Var "x") (Var "x")]]]
example "val_arith" : "fun main() { val x = 1 + 2 * 3 }" parses-to KtFile [] [FunDecl "main" [] "" [ValStmt False "x" "" [Bin Add (IntLit 1) (Bin Mul (IntLit 2) (IntLit 3))]]]
example "when_stmt" : "fun f(x: Int): Int { when (x) { 1 -> return 10; else -> return 0 } }" parses-to KtFile [] [FunDecl "f" [Param "" "x" "Int"] "Int" [WhenStmt [Var "x"] [WhenBranch [IntLit 1] [ReturnStmt [IntLit 10]], WhenElse [ReturnStmt [IntLit 0]]]]]
example "class_and_for" : "class Counter(var n: Int) { fun inc() { for (i in 1..5) { n += i } } }" parses-to KtFile [] [ClassDecl "class" "Counter" [Param "var" "n" "Int"] [FunDecl "inc" [] "" [ForStmt "i" (Bin Range (IntLit 1) (IntLit 5)) [AssignStmt "n" "+=" (Var "i")]]]]
example "package_import" : "package demo.app\nimport kotlin.math.*\nfun id(x: Int): Int = x" parses-to KtFile ["demo", "app"] [ImportDecl ["kotlin", "math"] "*", FunDecl "id" [Param "" "x" "Int"] "Int" [ReturnStmt [Var "x"]]]
example "if_while_method" : "fun loop(n: Int): Int { var s = 0; if (n > 0) { while (s < n) { s += 1 } } else { s = -1 }; return s.dec() }" parses-to KtFile [] [FunDecl "loop" [Param "" "n" "Int"] "Int" [ValStmt True "s" "" [IntLit 0], IfStmt (Bin Gt (Var "n") (IntLit 0)) [WhileStmt (Bin Lt (Var "s") (Var "n")) [AssignStmt "s" "+=" (IntLit 1)]] [AssignStmt "s" "=" (Unary Neg (IntLit 1))], ReturnStmt [MethodCall (Var "s") "dec" []]]]
example "err_expr" : "fun bad(): Int = 1 +" fails-at (1, 21) expecting "expression"
example "err_rbrace" : "fun bad() { val x = 1" fails-at (1, 22) expecting "}"
