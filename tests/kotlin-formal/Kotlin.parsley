module Kotlin (kotlinFile) where

import Parsley.Prelude (many, eof)
import Kotlin.Syntax

-- Синтаксис (derived from ANTLR4 KotlinParser.g4) ---------------
kotlinFile :: KtFile
kotlinFile = do
  pkg   <- packageHeader
  decls <- many topLevelDecl
  eof
  pure (KtFile pkg decls)

-- Примеры и тесты ----------------------------------------------
example "fun_expr" : "fun sq(x: Int): Int = x * x" parses-to KtFile [] [FunDecl "sq" NoTypeParameters [CastType "Int" [] NoTypeArguments []] (FunctionScope [CastType "Int" [] NoTypeArguments []] [FunctionParam "x" "Int" False []] [ReturnStmt [Bin Mul (Var "x") (Var "x")]])]
example "val_arith" : "fun main() { val x = 1 + 2 * 3 }" parses-to KtFile [] [FunDecl "main" NoTypeParameters [] (FunctionScope [] [] [ValStmt False "x" "" [Bin Add (IntLit 1) (Bin Mul (IntLit 2) (IntLit 3))]])]
example "when_stmt" : "fun f(x: Int): Int { when (x) { 1 -> return 10; else -> return 0 } }" parses-to KtFile [] [FunDecl "f" NoTypeParameters [CastType "Int" [] NoTypeArguments []] (FunctionScope [CastType "Int" [] NoTypeArguments []] [FunctionParam "x" "Int" False []] [WhenStmt [Var "x"] [WhenBranch [IntLit 1] [ReturnStmt [IntLit 10]], WhenElse [ReturnStmt [IntLit 0]]]])]
example "class_and_for" : "class Counter(var n: Int) { fun inc() { for (i in 1..5) { n += i } } }" parses-to KtFile [] [ClassDecl "class" "Counter" NoTypeParameters [Param "var" "n" "Int"] [FunDecl "inc" NoTypeParameters [] (FunctionScope [] [] [ForStmt "i" (Bin Range (IntLit 1) (IntLit 5)) [AssignStmt "n" "+=" (Var "i")]])] False]
example "package_import" : "package demo.app\nimport kotlin.math.*\nfun id(x: Int): Int = x" parses-to KtFile ["demo", "app"] [ImportDecl ["kotlin", "math"] "*", FunDecl "id" NoTypeParameters [CastType "Int" [] NoTypeArguments []] (FunctionScope [CastType "Int" [] NoTypeArguments []] [FunctionParam "x" "Int" False []] [ReturnStmt [Var "x"]])]
example "if_while_method" : "fun loop(n: Int): Int { var s = 0; if (n > 0) { while (s < n) { s += 1 } } else { s = -1 }; return s.dec() }" parses-to KtFile [] [FunDecl "loop" NoTypeParameters [CastType "Int" [] NoTypeArguments []] (FunctionScope [CastType "Int" [] NoTypeArguments []] [FunctionParam "n" "Int" False []] [ValStmt True "s" "" [IntLit 0], IfStmt (Bin Gt (Var "n") (IntLit 0)) [WhileStmt (Bin Lt (Var "s") (Var "n")) [AssignStmt "s" "+=" (IntLit 1)]] [AssignStmt "s" "=" (Unary Neg (IntLit 1))], ReturnStmt [MethodCall (CallReceiver "s") "dec" []]])]
example "exclusive_range" : "fun f(n: Int) { for (i in 0..<n + 1) {} }" parses-to KtFile [] [FunDecl "f" NoTypeParameters [] (FunctionScope [] [FunctionParam "n" "Int" False []] [ForStmt "i" (Bin RangeUntil (IntLit 0) (Bin Add (Var "n") (IntLit 1))) []])]
example "default_and_named_arguments" : "fun f(vararg x: Int, y: Int = 1): Int = y\nfun g(): Int = f(y = 2)" parses-to KtFile [] [FunDecl "f" NoTypeParameters [CastType "Int" [] NoTypeArguments []] (FunctionScope [CastType "Int" [] NoTypeArguments []] [FunctionParam "x" "Int" True [], FunctionParam "y" "Int" False [IntLit 1]] [ReturnStmt [Var "y"]]), FunDecl "g" NoTypeParameters [CastType "Int" [] NoTypeArguments []] (FunctionScope [CastType "Int" [] NoTypeArguments []] [] [ReturnStmt [Call "f" [NamedArg "y" (IntLit 2)]]])]
example "vararg_as_name" : "fun vararg(vararg: Int): Int = vararg" parses-to KtFile [] [FunDecl "vararg" NoTypeParameters [CastType "Int" [] NoTypeArguments []] (FunctionScope [CastType "Int" [] NoTypeArguments []] [FunctionParam "vararg" "Int" False []] [ReturnStmt [Var "vararg"]])]
example "postfix_chain" : "fun f() = make().size()" parses-to KtFile [] [FunDecl "f" NoTypeParameters [] (FunctionScope [] [] [ReturnStmt [PostfixChain (Call "make" []) [SelectSuffix False "size", InvokeSuffix []]]])]
example "safe_cast" : "fun f(x: Any) = x as? demo.Box<Int?>" parses-to KtFile [] [FunDecl "f" NoTypeParameters [] (FunctionScope [] [FunctionParam "x" "Any" False []] [ReturnStmt [CastChain (Var "x") [SafeCast (CastType "demo" ["Box"] (TypeArguments (CastType "Int" [] NoTypeArguments ["?"]) []) [])]]])]
example "throw_expression" : "fun f() = throw Error()" parses-to KtFile [] [FunDecl "f" NoTypeParameters [] (FunctionScope [] [] [ReturnStmt [ThrowExpr (Call "Error" [])]])]
example "generic_and_companion" : "interface Box<T: Any> { fun get(): T }\nclass Holder<T> { companion object Named { fun get() = 1 } }" parses-to KtFile [] [InterfaceDecl "Box" (TypeParameters (TypeParameter "T" [CastType "Any" [] NoTypeArguments []]) []) [FunDecl "get" NoTypeParameters [CastType "T" [] NoTypeArguments []] (FunctionScope [CastType "T" [] NoTypeArguments []] [] [])], ClassDecl "class" "Holder" (TypeParameters (TypeParameter "T" []) []) [] [CompanionDecl "Named" [FunDecl "get" NoTypeParameters [] (FunctionScope [] [] [ReturnStmt [IntLit 1]])]] False]
example "generic_call" : "fun <T> id(x: T): T = x\nfun f(): Int = id<Int>(1)" parses-to KtFile [] [FunDecl "id" (TypeParameters (TypeParameter "T" []) []) [CastType "T" [] NoTypeArguments []] (FunctionScope [CastType "T" [] NoTypeArguments []] [FunctionParam "x" "T" False []] [ReturnStmt [Var "x"]]), FunDecl "f" NoTypeParameters [CastType "Int" [] NoTypeArguments []] (FunctionScope [CastType "Int" [] NoTypeArguments []] [] [ReturnStmt [GenericCall "id" (TypeArguments (CastType "Int" [] NoTypeArguments []) []) [IntLit 1]]])]
example "try_finally" : "fun f() = try { 1 } finally {}" parses-to KtFile [] [FunDecl "f" NoTypeParameters [] (FunctionScope [] [] [ReturnStmt [TryExpr [ExprStmt (IntLit 1)] (FinallyOnly [])]])]
example "multiple_catches" : "fun f() = try {} catch (a: A) {} catch (b: B) {} finally {}" parses-to KtFile [] [FunDecl "f" NoTypeParameters [] (FunctionScope [] [] [ReturnStmt [TryExpr [] (CatchHandlers (CatchClause "a" (CastType "A" [] NoTypeArguments []) []) [CatchClause "b" (CastType "B" [] NoTypeArguments []) []] (FinallyBlock []))]])]
example "lambda_arguments" : "fun f() = run { x: Int -> x }" parses-to KtFile [] [FunDecl "f" NoTypeParameters [] (FunctionScope [] [] [ReturnStmt [Call "run" [LambdaExpr "{" (LambdaScope (ExplicitLambdaParams [LambdaParameter "x" [CastType "Int" [] NoTypeArguments []]]) [ExprStmt (Var "x")]) "}"]]])]
example "trailing_lambda_suffix" : "fun f() = apply(1) { 2 }" parses-to KtFile [] [FunDecl "f" NoTypeParameters [] (FunctionScope [] [] [ReturnStmt [PostfixChain (Call "apply" [IntLit 1]) [TrailingLambdaSuffix (LambdaExpr "{" (LambdaScope ImplicitLambdaParams [ExprStmt (IntLit 2)]) "}")]]])]
example "trailing_comma" : "fun f(x: Int,) = g(x,)" parses-to KtFile [] [FunDecl "f" NoTypeParameters [] (FunctionScope [] [FunctionParam "x" "Int" False []] [ReturnStmt [Call "g" [Var "x"]]])]
example "type_test_precedence" : "fun f(x: Any) = x !is Int == true" parses-to KtFile [] [FunDecl "f" NoTypeParameters [] (FunctionScope [] [FunctionParam "x" "Any" False []] [ReturnStmt [Bin Eq (TypeTestChain (Var "x") [TypeTest False (CastType "Int" [] NoTypeArguments [])]) (BoolLit True)]])]
example "annotation_declarations" : "@file:demo.Mark\npackage sample\nannotation class Outer { annotation class Inner }\n@Outer.Inner fun tagged(@param:demo.Mark x: Int) = x" parses-to KtFile ["sample"] [ClassDecl "annotation" "Outer" NoTypeParameters [] [ClassDecl "annotation" "Inner" NoTypeParameters [] [] False] False, FunDecl "tagged" NoTypeParameters [] (FunctionScope [] [FunctionParam "x" "Int" False []] [ReturnStmt [Var "x"]])]
example "constructor_parameter_defaults" : "class Config(val ordinary: Int, vararg val values: Int, val seed: Int = 2, val vararg: Int)" parses-to KtFile [] [ClassDecl "class" "Config" NoTypeParameters [Param "val" "ordinary" "Int", ExtendedClassParam "val" "values" "Int" True [], ExtendedClassParam "val" "seed" "Int" False [IntLit 2], Param "val" "vararg" "Int"] [] False]
example "spread_arguments" : "fun f() = call(*xs, items = *ys, 2 * 3)" parses-to KtFile [] [FunDecl "f" NoTypeParameters [] (FunctionScope [] [] [ReturnStmt [Call "call" [SpreadArg (Var "xs"), NamedArg "items" (SpreadArg (Var "ys")), Bin Mul (IntLit 2) (IntLit 3)]]])]
example "annotated_constructor_type" : "annotation class Ann(vararg val xs: @Mark String = [])" parses-to KtFile [] [ClassDecl "annotation" "Ann" NoTypeParameters [ExtendedClassParam "val" "xs" "String" True [CollectionLit []]] [] False]
example "collection_literal" : "fun f() = g([1, 2,])[0]" parses-to KtFile [] [FunDecl "f" NoTypeParameters [] (FunctionScope [] [] [ReturnStmt [PostfixChain (Call "g" [CollectionLit [IntLit 1, IntLit 2]]) [IndexSuffix (IntLit 0)]]])]
example "unary_updates" : "fun f() { xs[0]++; x--; ++y; --z; +a + b }" parses-to KtFile [] [FunDecl "f" NoTypeParameters [] (FunctionScope [] [] [ExprStmt (PostfixChain (Index (Var "xs") (IntLit 0)) [PostInc]), ExprStmt (PostfixChain (Var "x") [PostDec]), ExprStmt (Unary PreInc (Var "y")), ExprStmt (Unary PreDec (Var "z")), ExprStmt (Bin Add (Unary Pos (Var "a")) (Var "b"))])]
example "type_projections" : "fun out(x: Array<in String>): Pair<*, out String?> = x" parses-to KtFile [] [FunDecl "out" NoTypeParameters [CastType "Pair" [] (TypeArguments StarProjection [OutProjection (CastType "String" [] NoTypeArguments ["?"])]) []] (FunctionScope [CastType "Pair" [] (TypeArguments StarProjection [OutProjection (CastType "String" [] NoTypeArguments ["?"])]) []] [FunctionParam "x" "Array" False []] [ReturnStmt [Var "x"]])]
example "indexed_assignment" : "fun f() { a[i][j] += 2; a[i] %= 3 }" parses-to KtFile [] [FunDecl "f" NoTypeParameters [] (FunctionScope [] [] [IndexedAssignStmt "a" [Var "i", Var "j"] "+=" (IntLit 2), IndexedAssignStmt "a" [Var "i"] "%=" (IntLit 3)])]
example "extension_receiver" : "operator fun <T> demo.Box<T>?.get(i: Int) = this" parses-to KtFile [] [ExtensionFunDecl (CastType "demo" ["Box"] (TypeArguments (CastType "T" [] NoTypeArguments []) []) ["?"]) "get" (TypeParameters (TypeParameter "T" []) []) [] (FunctionScope [] [FunctionParam "i" "Int" False []] [ReturnStmt [Var "this"]])]
example "function_type" : "fun callback(f: (value: Int) -> String): () -> Int" parses-to KtFile [] [FunDecl "callback" NoTypeParameters [FunctionType [] (CastType "Int" [] NoTypeArguments [])] (FunctionScope [FunctionType [] (CastType "Int" [] NoTypeArguments [])] [FunctionTypedParam "f" (FunctionType [NamedTypeParameter "value" (CastType "Int" [] NoTypeArguments [])] (CastType "String" [] NoTypeArguments [])) False []] [])]
example "constructor_function_type" : "class Callback(val f: (Int) -> String)" parses-to KtFile [] [ClassDecl "class" "Callback" NoTypeParameters [FunctionTypedClassParam "val" "f" (FunctionType [CastType "Int" [] NoTypeArguments []] (CastType "String" [] NoTypeArguments [])) False []] [] False]
example "char_literal" : "fun f() = g('a', '\\n', '\\u0041', '\xD0\x96')" parses-to KtFile [] [FunDecl "f" NoTypeParameters [] (FunctionScope [] [] [ReturnStmt [Call "g" [CharLit "'a'", CharLit "'\\n'", CharLit "'\\u0041'", CharLit "'\xD0\x96'"]]])]
example "float_suffix" : "fun f() = g(1f, .5F, 1_000.25e-2f, 2E3F, 1.5, 1..3)" parses-to KtFile [] [FunDecl "f" NoTypeParameters [] (FunctionScope [] [] [ReturnStmt [Call "g" [Float32Lit "1f", Float32Lit ".5F", Float32Lit "1_000.25e-2f", Float32Lit "2E3F", FloatLit 1.5, Bin Range (IntLit 1) (IntLit 3)]]])]
example "err_lone_comma" : "fun f(,) {}" fails-at (1, 7) expecting ")"
example "err_expr" : "fun bad(): Int = 1 +" fails-at (1, 21) expecting "expression"
example "err_rbrace" : "fun bad() { val x = 1" fails-at (1, 22) expecting "}"
